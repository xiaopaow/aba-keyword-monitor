[Unit]
Description=DeepAurum ABA Web
After=network.target deepaurum-api.service
Wants=deepaurum-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/deepaurum/app
EnvironmentFile=/srv/deepaurum/config/web.env
ExecStart=/usr/bin/npm run start --workspace @aba/web -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
